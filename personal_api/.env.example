# ── Application ───────────────────────────────────────────────────────────
APP_NAME="David Musumali Personal API"
ENVIRONMENT=development          # development | production

# ── Security ──────────────────────────────────────────────────────────────
# Generate a new secret for production:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin account created automatically on first startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-Admin-2026
ADMIN_EMAIL=dmusumali01@gmail.com

# ── Database ──────────────────────────────────────────────────────────────
# SQLite now; swap for postgresql+psycopg://user:pass@host/db later
DATABASE_URL=sqlite:///./data/personal_api.db

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
